# Explicit isolated Supabase endpoint. Never copy production credentials into
# .env.local or staging. Get the local URL and publishable key from supabase status.
VITE_DEPLOY_STAGE=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace_with_local_publishable_key

# Only for a separately approved production release, NOT for Preview.
# VITE_DEPLOY_STAGE=production
# VITE_PRODUCTION_ORIGIN=https://approved-production-domain.example

# For cloud Preview: VITE_DEPLOY_STAGE=preview, and set URL/key to a separate
# hosted Supabase project. Localhost cannot serve a remote Vercel Preview.
# Do not put service_role, sb_secret_, OAuth client secrets or passwords in VITE_*.
